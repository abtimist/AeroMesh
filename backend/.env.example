# AeroMesh Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it's already in .gitignore.

# ─── Database (PostGIS via Docker) ────────────────────────────────────────────
DATABASE_URL=postgresql://aeromesh_user:aeromesh_password@localhost:5432/aeromesh_db

# ─── External API Keys ────────────────────────────────────────────────────────
# NASA FIRMS fire hotspot data: https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_API_KEY=your_nasa_firms_api_key_here

# OpenAQ ground sensor data (no key required for v3 basic access, optional for higher rate limits)
OPENAQ_API_KEY=

# Open-Meteo weather/wind data (completely free, no key needed)
# No key required — leave blank
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ─── Alert Dispatch (Optional for MVP) ────────────────────────────────────────
# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── App Settings ─────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173
