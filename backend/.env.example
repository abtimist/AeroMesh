# Copy to .env. Never commit credentials.
# Leave empty/unset for runtime/aeromesh.db (copied once from the bundled seed).
# DATABASE_URL=sqlite:///absolute/path/to/aeromesh.db
APP_ENV=development
DEBUG=true

# OpenAQ v3 requires an API key: https://docs.openaq.org/using-the-api/api-key
OPENAQ_API_KEY=
# NASA FIRMS map key: https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_API_KEY=
# WAQI API Key: https://aqicn.org/data-platform/token/
WAQI_API_KEY=
# Google Gemini API Key: https://aistudio.google.com/
GEMINI_API_KEY=

# Public Open-Meteo endpoints: no key for permitted non-commercial usage.
# Commercial usage requires a plan and customer endpoint configuration.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_AQ_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_API_KEY=

# GIBS satellite imagery requires no API key.
# NOAA READY access must be approved: https://www.ready.noaa.gov/READYmetapi.php
# Obtain the authentication instructions WITH the API key.
# Set the exact HTTP authentication headers as a JSON object. No scheme is assumed.
HYSPLIT_AUTH_HEADERS={}
HYSPLIT_BASE_URL=https://apps.arl.noaa.gov/ready2
HYSPLIT_POLL_SECONDS=300
HYSPLIT_DAILY_BUDGET=200
# A separate secret you choose; entered by an operator to submit model jobs.
MODEL_OPERATOR_TOKEN=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
